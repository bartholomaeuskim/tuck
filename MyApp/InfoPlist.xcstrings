{
  "sourceLanguage": "en",
  "strings": {
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to find free time in your calendar before each to-do's deadline, and to add, move, or remove the events tuck creates for your to-dos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ToDoの期限までのカレンダーの空き時間を探し、tuckがToDoのために作成した予定を追加・移動・削除するために使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일마다 마감 전까지 캘린더의 빈 시간을 찾고, tuck이 할 일을 위해 만든 일정을 추가·이동·삭제하는 데 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于在每个待办的截止时间前查找日历中的空闲时间，并添加、移动或删除 tuck 为待办创建的日程。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
