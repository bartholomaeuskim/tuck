    "Notifications are turned off in Settings, so you won't get this reminder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で通知がオフになっているため、期限の通知は届きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 알림이 꺼져 있어서 마감 알림이 오지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已在“设置”中关闭，因此你不会收到截止提醒。"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "ja": {
          "stringUnit": {
