          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "Scheduled": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュール済み"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 시간"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安排"
          }
        }
