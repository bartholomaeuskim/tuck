    },
    "Opens tuck and starts a new to-do.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tuckを開いて新しいToDoを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tuck을 열고 새 할 일을 바로 써요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 tuck 并新建待办。"
          }
        }
      }
    },
    "Overdue": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限切れ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마감 지남"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已逾期"
          }
        }
      }
    },
    "Reads your calendar to find free time before the deadline, then adds the time you pick as an event.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーを読み取って期限までの空き時間を探し、選んだ時間を予定として追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더를 읽어서 마감 전 비어 있는 시간을 찾고, 고른 시간을 일정으로 추가해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取你的日历以查找截止时间前的空闲时间，并将你选择的时间添加为日程。"
          }
        }
      }
    },
    "Remind at Deadline": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限に通知"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마감에 알림"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截止时通知"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        },
        "ko": {
