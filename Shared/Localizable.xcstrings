    },
    "Searched until %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@まで探しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@까지 찾았어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已查找到 %@。"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "Split into %lld Parts": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Split into %lld Part"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Split into %lld Parts"
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld回に分ける"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld번에 나눠 하기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分成 %lld 段"
          }
        }
      }
    },
    "Start": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始"
          }
        }
      }
    },
    "Suggestions only use this part of the day.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提案は1日のうちこの時間帯の中からだけ探します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천은 하루 중 이 시간대 안에서만 찾아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在一天中的这个时间段内查找建议。"
          }
        }
      }
    },
    "Tap + to add a to-do.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "+ボタンでToDoを追加しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "+ 버튼으로 할 일을 추가해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击 + 添加待办。"
          }
        }
      }
    },
    "That Time Has Passed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時間はすでに過ぎています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 지난 시간이에요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该时间已过"
          }
        }
      }
    },
    "The %lld linked calendar events will also be deleted.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The linked calendar event will also be deleted."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The %lld linked calendar events will also be deleted."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクしているカレンダーの予定%lld件も削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 캘린더 일정 %lld개도 함께 삭제돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关联的 %lld 个日历日程也会被删除。"
          }
        }
      }
    },
    "The deadline has passed, so there's no time to suggest.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限を過ぎているため、提案できる時間はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마감이 지나서 추천할 시간이 없어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已过截止时间，没有可建议的时间。"
          }
        }
      }
    },
    "The suggestions were updated.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめの時間を更新しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천 시간을 새로 고쳤어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已更新建议时间。"
          }
        }
      }
    },
    "There's %@ of free time before the deadline, but no single free block is long enough.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限までの空き時間は合計%@ありますが、一度にできるほど長い空きがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마감 전 빈 시간은 모두 %@이지만, 한 번에 할 만큼 긴 빈틈이 없어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截止时间前共有 %@ 的空闲时间，但没有足够长的连续时段。"
          }
        }
      }
    },
    "There's no calendar to add events to. Check your default calendar in the Calendar app.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定を追加できるカレンダーがありません。カレンダーAppでデフォルトのカレンダーを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정을 추가할 수 있는 캘린더가 없어요. 캘린더 앱에서 기본 캘린더를 확인해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可添加日程的日历。请在“日历”App 中检查默认日历。"
          }
        }
      }
    },
    "There's no single free block long enough before the deadline, so the time is split into parts of 30 minutes or more.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限までに一度にできるほど続いた空き時間がないため、30分以上ずつに分けました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마감 전에 한 번에 할 만큼 이어진 빈 시간이 없어서 30분 이상씩 나눴어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截止时间前没有足够长的连续空闲时间，因此分成了每段至少 30 分钟。"
          }
        }
      }
    },
    "There's no time to search before the deadline. Free time is searched between %@ and %@ each day.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限までに探せる時間がありません。空き時間は毎日%1$@から%2$@の間で探します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마감 전에 찾아볼 시간이 없어요. 빈 시간은 매일 %1$@부터 %2$@ 사이에서 찾아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截止时间前没有可查找的时间。每天会在 %1$@ 到 %2$@ 之间查找空闲时间。"
          }
        }
      }
    },
    "There's only %@ of free time before the deadline.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限までの空き時間は合計%@しかありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마감 전 빈 시간이 모두 %@뿐이에요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截止时间前总共只有 %@ 的空闲时间。"
          }
        }
      }
    },
