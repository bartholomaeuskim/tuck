    "Find Free Time": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き時間を探す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 시간 찾기"
