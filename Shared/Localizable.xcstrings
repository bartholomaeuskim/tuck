{
  "sourceLanguage": "en",
  "strings": {
    "%@ %@": {
      "shouldTranslate": false
    },
    "%@ Ends after the deadline": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 期限の後に終わります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 마감 뒤에 끝나요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将在截止时间后结束"
          }
        }
      }
    },
    "%@ · %@": {
      "shouldTranslate": false
    },
    "Add To-Do": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ToDoを追加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 일 추가"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加待办"
          }
        }
      }
    },
    "Add an estimated time, then tap the calendar button in the list to find free time before the deadline.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "所要時間を入力すると、リストのカレンダーボタンから期限までの空き時間を提案します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예상 소요시간을 넣으면 목록의 캘린더 버튼으로 마감 전 빈 시간을 추천받을 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写预计用时后，点击列表中的日历按钮，即可获得截止时间前的空闲时间建议。"
          }
        }
      }
    },
    "Add to Calendar": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーに追加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더에 추가"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加到日历"
          }
        }
      }
    },
    "Add to calendar?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーに追加しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더에 추가할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要添加到日历吗？"
          }
        }
      }
    },
    "Allow Calendar Access": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーへのアクセスを許可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 접근 허용"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问日历"
          }
        }
      }
    },
    "Avoided %lld calendar events.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Avoided %lld calendar event."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Avoided %lld calendar events."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーの予定%lld件を避けました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 일정 %lld개를 피했어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已避开 %lld 个日历日程。"
          }
        }
      }
    },
    "Call the dentist": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歯医者に電話する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "치과에 전화하기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给牙医打电话"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Change Schedule": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュールを変更"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 시간 바꾸기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改安排"
          }
        }
      }
    },
    "Change the scheduled time?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュールを変更しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할 시간을 바꿀까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要更改安排的时间吗？"
          }
        }
      }
    },
    "Check off today's to-dos without opening the app.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開かずに今日のToDoを完了にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 열지 않고 오늘 할 일을 체크해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需打开 App 即可勾选今天的待办。"
          }
        }
      }
    },
    "Choose this app's language in Settings. If you don't see Language there, first add another language in General > Language & Region.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定Appでこのアプリの言語を選べます。「言語」が表示されない場合は、先に「一般」>「言語と地域」で別の言語を追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 앱에서 이 앱의 언어를 고를 수 있어요. 언어 항목이 보이지 않으면 먼저 일반 > 언어 및 지역에서 언어를 하나 더 추가해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在“设置”中选择此 App 的语言。如果没有看到“语言”，请先在“通用”>“语言与地区”中添加另一种语言。"
          }
        }
      }
    },
